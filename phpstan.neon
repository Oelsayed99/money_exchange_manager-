includes:
    - vendor/larastan/larastan/extension.neon

# There is no baseline. There was one — 20 inherited errors from the Laravel
# starter kit and the stock config files — and it was cleared in Phase 7. Level 8
# now holds across the whole application with nothing exempted.
#
# Do not reintroduce one. A baseline is a list of things the analyser found and
# was told to stop mentioning; the last entry on the last list was hiding a
# TypeError on a live route.

parameters:
    paths:
        - app
        - config
        - database
        - routes

    level: 8

    # Financial code must not accumulate untyped edges. If a rule here becomes
    # noisy, narrow it with an explicit ignoreErrors entry and a reason — do not
    # lower the level.
